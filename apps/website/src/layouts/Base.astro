---
import { Font, getImage } from 'astro:assets'
import sathorn from '../assets/photos/sathorn-unique-tower-ii.jpg'
import { site } from '../data/site'
import { pickLocale } from '../i18n/detect.mjs'
import { defaultLocale, languages, localePath, locales, useLocale } from '../i18n'
import '../styles/site.css'

const { locale, t, lang } = useLocale(Astro.currentLocale)
const canonical = new URL(localePath(locale), Astro.site)
const og = await getImage({ src: sathorn, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 })
const ogUrl = new URL(og.src, Astro.site)
const preload = locale === defaultLocale ? 'thai' : 'latin'
const media = process.env.MEDIA_ORIGIN // see astro.config.mjs

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: site.name,
    url: canonical.href,
    email: site.email,
    description: t.meta.description,
    image: ogUrl.href,
    areaServed: { '@type': 'Country', name: 'Thailand' },
    address: { '@type': 'PostalAddress', addressLocality: 'Bangkok', addressCountry: 'TH' },
    knowsLanguage: locales.map((l) => languages[l].tag),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: lang.tag,
    mainEntity: t.faq.items.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
]

// Fallback for hosts without worker.mjs (astro dev, astro preview): the Thai root sends a first-time visitor to their browser language.
const detect = `try{var l=(${pickLocale})({saved:(document.cookie.match(/(?:^|; )lang=(\\w+)/)||[])[1],languages:navigator.languages,userAgent:navigator.userAgent});if(l!=='${defaultLocale}')location.replace('/'+l+'/'+location.hash)}catch(e){}`
---

<!doctype html>
<html lang={lang.tag}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {locale === defaultLocale && <script is:inline set:html={detect} />}
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={canonical} />
    {locales.map((l) => <link rel="alternate" hreflang={languages[l].tag} href={new URL(localePath(l), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(localePath(defaultLocale), Astro.site)} />
    <meta name="theme-color" content="#1e2235" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {media && <link rel="preconnect" href={media} />}
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang.og} />
    {locales.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={languages[l].og} />)}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    {
      locale === 'vi' ? (
        <Font cssVariable="--font-text-vi" preload={[{ subset: 'latin', weight: 700 }, { subset: 'latin', weight: 400 }]} />
      ) : (
        <Font cssVariable="--font-text" preload={locale === 'zh' ? undefined : [{ subset: preload, weight: 700 }, { subset: preload, weight: 400 }]} />
      )
    }
    <Font cssVariable="--font-display" />
    {locale !== 'vi' && <Font cssVariable="--font-hero" preload={locale === 'en' ? [{ subset: 'latin', weight: 700 }, { subset: 'latin', weight: 400 }] : undefined} />}

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body>
    <slot />
  </body>
</html>
