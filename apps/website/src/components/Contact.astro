---
import { Picture } from 'astro:assets'
import rack from '../assets/photos/server-rack.jpg'
import posterSrc from '../assets/photos/skytrain-poster.jpg'
import { credits, site } from '../data/site'

const subject = encodeURIComponent('นัดออดิตซิสเต็ม')
const blocks = [
  ['B', 100], ['O', 72], ['R', 88], ['O', 64], ['M', 94], ['T', 78], ['E', 60], ['C', 84], ['H', 70],
] as const
---

<section class="chapter contact" id="contact" aria-labelledby="contact-title">
  <div class="tiles">
    <div class="tile tile-flank tile-left">
      <Picture src={posterSrc} formats={['avif', 'webp']} widths={[320, 640, 960]} sizes="(max-width: 900px) 46vw, 16vw" alt="" loading="lazy" />
      <video muted loop playsinline preload="none" width="854" height="480" aria-hidden="true" data-lazy-video>
        <source data-src="/media/bangkok-skytrain-p1110323.webm" type="video/webm" />
      </video>
    </div>
    <div class="tile tile-main">
      <h2 id="contact-title" class="m reveal">ส่งซิสเต็มมาให้เราดู</h2>
      <p class="reveal">ไม่ว่าโปรเจกต์จะติดขัดตรงไหน หรือกำลังหาทีมดูแลต่อ เล่าอาการสั้นๆ ให้เราฟัง เราตอบกลับภายในหนึ่งวันทำการ พร้อมนัดวันออดิต</p>
      <a class="button button-dark reveal" href={`mailto:${site.email}?subject=${subject}`}>เขียนถึงเรา</a>
    </div>
    <div class="tile tile-flank tile-right">
      <Picture src={rack} formats={['avif', 'webp']} widths={[320, 640, 960]} sizes="(max-width: 900px) 46vw, 16vw" alt="ตู้เซิร์ฟเวอร์เก่าที่จัดสายแลนใหม่อย่างเป็นระเบียบ" loading="lazy" />
    </div>
  </div>
</section>

<footer class="footer">
  <div class="blocks" role="img" aria-label="BoromTech">
    {blocks.map(([letter, h]) => <span style={`--h:${h}%`} aria-hidden="true">{letter}</span>)}
  </div>
  <div class="footer-grid">
    <ul>
      <li><a class="link" href="#cases">งานที่เรารับ</a></li>
      <li><a class="link" href="#process">โปรเซส</a></li>
    </ul>
    <ul>
      <li><a class="link" href="#team">ทีม</a></li>
      <li><a class="link" href="#faq">คำถาม</a></li>
    </ul>
    <address>{site.email}<br />{site.city}</address>
  </div>
  <p class="credits">
    ภาพประกอบบางส่วนสร้างด้วย AI · ภาพถ่ายจาก Wikimedia Commons:{' '}
    {
      credits.map((c, i) => (
        <>
          <a class="link" href={c.href} rel="noopener">"{c.title}"</a> โดย {c.by}, {c.licence}
          {i < credits.length - 1 && ' · '}
        </>
      ))
    }
  </p>
  <div class="footer-last">
    <span>© 2569 BoromTech</span>
    <a class="button button-small" href="#contact">นัดออดิต</a>
  </div>
</footer>
