---
import { Picture } from 'astro:assets'
import rack from '../assets/photos/server-rack.jpg'
import posterSrc from '../assets/photos/skytrain-poster.jpg'
import { credits, site } from '../data/site'
import { useLocale } from '../i18n'
import LangSwitch from './LangSwitch.astro'
import wordmark from '../../../../design-system/brand/logos/wordmark-light.svg?raw'

const { t } = useLocale(Astro.currentLocale)
const subject = encodeURIComponent(t.contact.emailSubject)
// The same wordmark as the header.
const logo = wordmark.replace('<svg ', '<svg aria-hidden="true" focusable="false" ')
---

<section class="chapter contact" id="contact" aria-labelledby="contact-title">
  <div class="tiles">
    <div class="tile tile-flank tile-left">
      <Picture src={posterSrc} formats={['avif', 'webp']} widths={[320, 640, 960]} sizes="(max-width: 900px) 46vw, 16vw" alt="" loading="lazy" />
      <video muted loop playsinline preload="none" width="854" height="480" aria-hidden="true" data-lazy-video>
        <source data-src="/media/bangkok-skytrain-p1110323.webm" type="video/webm" />
      </video>
    </div>
    <div class="tile tile-main">
      <h2 id="contact-title" class="m reveal">{t.contact.title}</h2>
      <p class="reveal">{t.contact.body}</p>
      <a class="button button-dark reveal" href={`mailto:${site.email}?subject=${subject}`}>{t.contact.cta}</a>
    </div>
    <div class="tile tile-flank tile-right">
      <Picture src={rack} formats={['avif', 'webp']} widths={[320, 640, 960]} sizes="(max-width: 900px) 46vw, 16vw" alt={t.contact.photoAlt} loading="lazy" />
    </div>
  </div>
</section>

<footer class="footer">
  <div class="footer-bar">
    <a class="footer-logo" href="#top" aria-label="BoromTech"><Fragment set:html={logo} /></a>
    <nav class="footer-nav" aria-label={t.nav.label}>
      <a class="link" href="#cases">{t.nav.cases}</a>
      <a class="link" href="#audit">{t.nav.audit}</a>
      <a class="link" href="#report">{t.nav.report}</a>
      <a class="link" href="#faq">{t.nav.faq}</a>
    </nav>
    <LangSwitch list />
    <a class="button button-small" href="#contact">{t.nav.cta}</a>
  </div>
  <div class="footer-meta">
    <span>{t.footer.copyright}</span>
    <!-- Each part of the address stays whole; Thai line breaking does not know the place names. -->
    <address lang="th">{site.address.split(' ').map((part, i) => <>{i > 0 && ' '}<span class="nb">{part}</span></>)}</address>
    <a class="link" href={`mailto:${site.email}`}>{site.email}</a>
  </div>
  <p class="credits">
    {t.footer.credits}{' '}
    {
      credits.map((c, i) => (
        <>
          <a class="link" href={c.href} rel="noopener">"{c.title}{c.video && ` (${t.footer.video})`}"</a> {t.footer.by} {c.by}, {c.licence}
          {i < credits.length - 1 && ' · '}
        </>
      ))
    }
  </p>
</footer>
