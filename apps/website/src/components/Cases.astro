---
import { Picture } from 'astro:assets'
import house from '../assets/unfinished-luxury-house-cases.jpg'
import { site } from '../data/site'
import i1 from '../icons/symptoms/icon-01-broken-app.svg?raw'
import i2 from '../icons/symptoms/icon-02-ai-misaligned-blocks.svg?raw'
import i3 from '../icons/symptoms/icon-03-calling-unanswered.svg?raw'
import i4 from '../icons/symptoms/icon-04-missing-code-docs.svg?raw'
import i5 from '../icons/symptoms/icon-05-server-warning.svg?raw'
import i6 from '../icons/symptoms/icon-06-gauge-redline.svg?raw'
import i7 from '../icons/symptoms/icon-07-pro-team-support.svg?raw'
import { useLocale } from '../i18n'

const { t } = useLocale(Astro.currentLocale)
const c = t.cases
// One icon per symptom, in the same order as the symptoms in i18n.
const icons = [i1, i2, i3, i4, i5, i6, i7]
---

<section class="chapter cases" id="cases" aria-labelledby="cases-title">
  <div class="cases-picture">
    <figure class="shutter">
      <Picture
        src={house}
        formats={['avif', 'webp']}
        width={768}
        widths={[480, 768]}
        sizes="(max-width: 900px) 92vw, 40vw"
        alt={c.photoAlt}
        loading="lazy"
      />
    </figure>
    <p class="caption">{c.photoCaption}</p>
  </div>
  <div class="cases-body">
    <h2 id="cases-title" class="l reveal">{c.title}</h2>
    <p class="reveal">{c.intro}</p>
    <ul class="symptoms" id="symptoms">
      {
        c.symptoms.map(({ symptom, remedy }, i) => (
          <li>
            <label>
              <span class="symptom-icon" set:html={icons[i]} />
              <input type="checkbox" name="case" />
              <span class="symptom">{symptom}</span>
            </label>
            <button class="remedy-toggle" type="button" aria-expanded="false" aria-controls={`remedy-${i + 1}`} aria-label={c.remedyToggle} />
            <div class="remedy" id={`remedy-${i + 1}`}>
              <p>{remedy}</p>
            </div>
          </li>
        ))
      }
    </ul>
    <div class="verdict" aria-live="polite">
      <p class="verdict-line" id="verdict-line" data-default={c.verdict} data-picked={c.verdictPicked}>{c.verdict}</p>
      <a class="button" id="verdict-send" href="#contact" data-mail={site.email} data-subject={c.emailSubject} data-body={c.emailBody}>{c.cta}</a>
    </div>
  </div>
</section>
