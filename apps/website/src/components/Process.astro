---
import { stages } from '../data/site'
---

<section class="chapter process" id="process" aria-labelledby="process-title">
  <h2 id="process-title" class="l reveal">จากออดิต สู่การันตี</h2>
  <div class="stages" data-ui>
    {
      stages.map((s) => (
        <div class={`stage stage-${s.key}`} style={`--grow:${s.days}`} data-note={s.note}>
          <span class="stage-time">{s.time}</span>
        </div>
      ))
    }
  </div>
  <ol class="stage-notes">
    {stages.map((s) => <li style={`--grow:${s.days}`} class="reveal">{s.note}</li>)}
  </ol>
</section>
