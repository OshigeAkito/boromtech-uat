---
import { stages } from '../data/site'
import { useLocale } from '../i18n'

const { t } = useLocale(Astro.currentLocale)
const steps = stages.map((s, i) => ({ ...s, time: t.process.times[i], note: t.process.notes[i] }))
---

<section class="chapter process" id="process" aria-labelledby="process-title">
  <h2 id="process-title" class="l reveal">{t.process.title}</h2>
  <div class="stages" data-ui>
    {
      steps.map((s) => (
        <div class={`stage stage-${s.key}`} style={`--grow:${s.days}`} data-note={s.note}>
          <span class="stage-time">{s.time}</span>
        </div>
      ))
    }
  </div>
  <ol class="stage-notes">
    {steps.map((s) => <li style={`--grow:${s.days}`} class="reveal">{s.note}</li>)}
  </ol>
</section>
