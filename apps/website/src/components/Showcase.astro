---
import { sampleDocs } from '../data/showcase'
import { useLocale } from '../i18n'

const { locale, t } = useLocale(Astro.currentLocale)
const s = t.showcase
const doc = sampleDocs(locale)
const findings = ['critical', 'critical', 'high', 'high', 'high'] as const
const tasks = ['done', 'done', 'done', 'review', 'work'] as const
---

<section class="chapter showcase" id="report" aria-labelledby="showcase-title">
  <h2 id="showcase-title" class="l reveal showcase-title">{s.title}</h2>
  <div class="outputs" role="tablist" aria-label={s.tablist}>
    <button role="tab" aria-selected="true" aria-controls="sheet-audit" data-sheet="audit">{doc.tabs.audit}</button>
    <button role="tab" aria-selected="false" aria-controls="sheet-weekly" data-sheet="weekly">{doc.tabs.weekly}</button>
    <button role="tab" aria-selected="false" aria-controls="sheet-warranty" data-sheet="warranty">{doc.tabs.warranty}</button>
    <p class="outputs-note">{s.note}</p>
    <p class="outputs-mock">{s.mock}</p>
  </div>
  <div class="desk" lang={doc.lang}>
    <div class="sheet sheet-narrow" id="sheet-audit" role="tabpanel" data-ui>
      <div class="sheet-head"><strong>BoromTech</strong><span>{doc.audit.head}</span></div>
      <h3>{doc.audit.title}</h3>
      <p class="sheet-meta">{doc.audit.meta}</p>
      <div class="severity"><span class="sev sev-critical">{doc.severity.critical} <b>2</b></span><span class="sev sev-high">{doc.severity.high} <b>5</b></span><span class="sev sev-mid">{doc.severity.mid} <b>9</b></span></div>
      <ol class="findings">
        {doc.audit.findings.map((text, i) => <li><b>{doc.severity[findings[i]]}</b><span>{text}</span></li>)}
      </ol>
    </div>
    <div class="sheet sheet-narrow" id="sheet-weekly" role="tabpanel" data-ui hidden>
      <div class="sheet-head"><strong>BoromTech</strong><span>{doc.weekly.head}</span></div>
      <h3>{doc.weekly.title}</h3>
      <div class="meter"><span style="width:58%"></span></div>
      <ul class="tasks">
        {doc.weekly.tasks.map((text, i) => <li><span class={`pill pill-${tasks[i]}`}>{doc.weekly.status[tasks[i]]}</span><span>{text}</span></li>)}
      </ul>
      <p class="sheet-meta">{doc.weekly.next}</p>
    </div>
    <div class="sheet sheet-narrow" id="sheet-warranty" role="tabpanel" data-ui hidden>
      <div class="sheet-head"><strong>BoromTech</strong><span>{doc.warranty.head}</span></div>
      <h3>{doc.warranty.title}</h3>
      <dl class="terms">
        {doc.warranty.terms.map(([term, detail]) => <div><dt>{term}</dt><dd>{detail}</dd></div>)}
      </dl>
    </div>
  </div>
</section>
