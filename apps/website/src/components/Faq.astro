---
import { Picture } from 'astro:assets'
import bench from '../assets/photos/restoration-bench.jpg'
import { faqs } from '../data/site'
---

<section class="chapter faq" id="faq" aria-labelledby="faq-title">
  <div class="faq-head">
    <h2 id="faq-title" class="l reveal">ก่อนเริ่มงาน</h2>
    <Picture
      src={bench}
      formats={['avif', 'webp']}
      widths={[480, 800, 1200, 1600]}
      sizes="(max-width: 900px) 92vw, 38vw"
      alt="แผงวงจรคอมพิวเตอร์เก่าบนโต๊ะรีสโตร์ ข้างแหนบ แว่นขยาย และหัวแร้ง ใต้แสงโคมไฟอุ่น"
      loading="lazy"
    />
  </div>
  {
    faqs.map(({ q, a }) => (
      <div class="qa">
        <h3>{q}</h3>
        <p>{a}</p>
      </div>
    ))
  }
</section>
