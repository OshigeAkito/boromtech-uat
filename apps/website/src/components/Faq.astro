---
import { useLocale } from '../i18n'

const { t } = useLocale(Astro.currentLocale)

// What is in place before any work starts, drawn as the documents themselves: an NDA, the 5-day audit plan and
// a fixed-price quote. They read as the real documents do, in English, like the samples in the showcase.
const days = ['Discovery', 'Codebase', 'Data', 'Infra', 'Report']

const pad = (n: number) => String(n).padStart(2, '0')
---

<section class="chapter faq" id="faq" aria-labelledby="faq-title">
  <!-- Desktop: this column sticks while the questions scroll. -->
  <div class="faq-aside">
    <div class="faq-lead">
      <h2 id="faq-title" class="l reveal">{t.faq.title}</h2>
      <p class="reveal">{t.faq.lead}</p>
      <ul class="principles reveal" role="list">
        {t.faq.principles.map((item) => <li>{item}</li>)}
      </ul>
    </div>
    <div class="docs" aria-hidden="true">
      <div class="doc doc-nda">
        <div class="doc-head"><strong>BoromTech</strong><span>NDA · BT-N-0412</span></div>
        <p class="doc-title">Mutual Non-Disclosure Agreement</p>
        <p class="doc-line">Executed before any repository or server access</p>
        <div class="doc-sign">
          <svg viewBox="0 0 120 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 22c8-14 14-16 12-4s6 8 12-4 8-6 8 2 10 4 16-6 6 0 10 6 12-2 18-4" /></svg>
          <span>Signed · 2 Nov 2026</span>
        </div>
      </div>
      <div class="doc doc-audit">
        <div class="doc-head"><strong>BoromTech</strong><span>Audit Plan · BT-A-0412</span></div>
        <p class="doc-title">5-Day System Audit</p>
        <ol class="doc-days">
          {days.map((day, i) => <li><b>D{i + 1}</b>{day}</li>)}
        </ol>
      </div>
      <div class="doc doc-quote">
        <div class="doc-head"><strong>BoromTech</strong><span>Quotation · BT-Q-0412</span></div>
        <p class="doc-title">Fixed-Price Quotation</p>
        <dl class="doc-terms">
          <div><dt>Scope</dt><dd>Work items BT-104 to BT-115</dd></div>
          <div><dt>Price</dt><dd>Fixed, agreed before work starts</dd></div>
          <div><dt>Validity</dt><dd>30 days</dd></div>
        </dl>
        <span class="doc-stamp">Fixed price</span>
      </div>
    </div>
  </div>
  <div class="faq-list">
    <h3 class="m faq-list-title">{t.faq.listTitle}</h3>
    {
      t.faq.items.map(({ q, a }, i) => (
        <details class="qa" name="faq" open={i === 0}>
          <summary>
            <span class="qa-num" aria-hidden="true">{pad(i + 1)}</span>
            <h4>{q}</h4>
            <span class="qa-icon" aria-hidden="true" />
          </summary>
          <div class="qa-answer">
            <p>{a}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  /* Two columns on desktop: the lead and the documents on the left, sticky; the questions on the right. Global
     .faq, .faq-lead and .principles rules in site.css are overridden here where they clash. */
  .faq {
    display: grid;
    grid-template-columns: minmax(0, 5.5fr) minmax(0, 6.5fr);
    column-gap: var(--gap);
    align-items: start;
    /* .chapter's overflow: hidden would make the section its own scroller and stop the aside sticking. */
    overflow: clip;
    /* The left side of the section is orange, edge to edge, up to the middle of the gap between the columns. */
    --split: calc(var(--m) + (100% - 2 * var(--m) - var(--gap)) * 5.5 / 12 + var(--gap) / 2);
    background: linear-gradient(to right, var(--orange) var(--split), var(--sunken) var(--split));
    padding: clamp(64px, 8vw, 120px) max(var(--m), env(safe-area-inset-right)) clamp(64px, 8vw, 120px) max(var(--m), env(safe-area-inset-left));
  }

  .faq-aside {
    position: sticky;
    top: var(--m);
    display: grid;
    gap: 32px;
    color: var(--ink);
  }

  /* site.css spans .faq-lead over six columns, which would add implicit columns to this grid. */
  .faq-lead {
    grid-column: auto;
    gap: 16px;
  }

  .faq-lead p {
    max-width: none;
    font-size: var(--t-body);
    font-weight: 700;
  }

  /* The three principles, one per line. */
  .principles {
    flex-direction: column;
    gap: 8px;
    margin: 0;
  }

  /* The title is short enough to break only at spaces. The questions are longer, so they keep Thai's own word
     breaking; loanwords are already held together by the thai-loanwords build step. */
  h2 {
    word-break: keep-all;
  }


  .faq-list {
    display: grid;
    gap: 12px;
  }

  .faq-list-title {
    margin: 0 0 12px;
    word-break: keep-all;
  }

  .qa {
    display: block;
    padding: 0;
    background: var(--paper);
    border: 1px solid transparent;
    border-radius: 16px;
    transition: border-color 160ms ease;
    interpolate-size: allow-keywords;
  }

  .qa:has(summary:hover),
  .qa:has(summary:focus-visible) {
    border-color: var(--orange);
  }

  summary {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) 24px;
    align-items: center;
    gap: 16px;
    padding: 22px 24px;
    list-style: none;
    cursor: pointer;
    border-radius: 15px;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:focus-visible {
    outline: 3px solid var(--orange-deep);
    outline-offset: 3px;
  }

  .qa-num {
    font: 700 var(--t-s) / 1 var(--f-display);
    color: var(--orange-deep);
    font-variant-numeric: tabular-nums;
  }

  .qa h4 {
    margin: 0;
    font-size: var(--t-body);
    line-height: 1.45;
  }

  /* A plus whose upright bar folds away, leaving a minus, when the question opens. */
  .qa-icon {
    position: relative;
    width: 24px;
    height: 24px;
  }

  .qa-icon::before,
  .qa-icon::after {
    content: "";
    position: absolute;
    left: 5px;
    right: 5px;
    top: 11px;
    height: 2px;
    border-radius: 1px;
    background: var(--ink);
  }

  .qa-icon::after {
    rotate: 90deg;
  }

  .qa[open] .qa-icon {
    rotate: 180deg;
  }

  .qa[open] .qa-icon::after {
    rotate: 0deg;
  }

  .qa-answer {
    padding: 0 24px 24px calc(24px + 2ch + 16px);
  }

  .qa-answer p {
    grid-column: auto;
    margin: 0;
    max-width: 38em;
    font-size: var(--t-body);
    line-height: 1.7;
  }

  @media (prefers-reduced-motion: no-preference) {
    .qa-icon,
    .qa-icon::after {
      transition: rotate 220ms var(--ease-out);
    }

    .qa::details-content {
      block-size: 0;
      overflow: clip;
      transition: block-size 260ms var(--ease-out), content-visibility 260ms allow-discrete;
    }

    .qa[open]::details-content {
      block-size: auto;
    }
  }

  /* Three cards fanned in the left column, each header left showing, the quote on top. */
  .docs {
    position: relative;
    height: clamp(340px, 29vw, 420px);
  }

  .doc {
    position: absolute;
    width: 74%;
    min-height: 52%;
    padding: 22px 26px 26px;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--f-text);
    font-size: 14px;
    line-height: 1.5;
    box-shadow: 0 24px 48px -24px rgb(30 34 53 / 0.55), 0 2px 6px rgb(30 34 53 / 0.12);
  }

  .doc-nda {
    top: 0;
    left: 0;
    rotate: -5deg;
  }

  .doc-audit {
    top: 25%;
    left: 11%;
    rotate: 2deg;
  }

  /* Pinned to the foot of the fan, so a card taller than expected never falls out of the panel. */
  .doc-quote {
    bottom: 0;
    left: 22%;
    rotate: -1.5deg;
  }

  .doc-head {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 12px;
    margin-bottom: 14px;
    border-bottom: 1px solid #e6e3df;
    font-size: 12px;
    color: var(--muted);
  }

  .doc-head strong {
    font: 800 15px/1 var(--f-display);
    color: var(--ink);
  }

  .doc-title {
    margin: 0 0 8px;
    font: 700 clamp(17px, 1.5vw, 21px)/1.25 var(--f-display);
  }

  .doc-line {
    margin: 0;
    color: var(--muted);
  }

  .doc-sign {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 18px;
    color: var(--muted);
  }

  .doc-sign svg {
    width: 96px;
    color: var(--ink);
  }

  .doc-days {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 4px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
    font-size: 11px;
    color: var(--muted);
  }

  .doc-days li {
    display: grid;
    gap: 6px;
    padding-top: 8px;
    border-top: 4px solid var(--orange);
  }

  .doc-days b {
    color: var(--ink);
  }

  .doc-terms {
    display: grid;
    gap: 6px;
    margin: 12px 0 0;
  }

  .doc-terms div {
    display: grid;
    grid-template-columns: 74px 1fr;
    gap: 8px;
  }

  .doc-terms dt {
    color: var(--muted);
  }

  .doc-terms dd {
    margin: 0;
    font-weight: 600;
  }

  .doc-stamp {
    position: absolute;
    right: 22px;
    bottom: 18px;
    padding: 4px 10px;
    border: 2px solid var(--orange-deep);
    color: var(--orange-deep);
    font: 800 12px/1.2 var(--f-display);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    rotate: -8deg;
  }

  @media (max-width: 900px) {
    /* One column, in reading order: lead and documents, then the questions. */
    .faq {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 32px;
      padding-top: 48px;
      padding-bottom: 48px;
      background: var(--sunken);
    }

    /* Stacked, the orange side becomes a full-width band behind the lead and the documents. */
    .faq-aside {
      position: static;
      margin: -48px calc(-1 * var(--m)) 0; /* equals the section's top padding, so the band starts at its top edge */
      padding: 48px var(--m) 40px;
      background: var(--orange);
    }


    summary {
      gap: 12px;
      padding: 18px 20px;
    }

    .qa-answer {
      padding: 0 20px 20px;
    }

    .docs {
      height: 424px;
    }

    .doc {
      width: 84%;
      padding: 18px 20px 22px;
    }

    .doc-audit {
      left: 7%;
    }

    .doc-quote {
      left: 14%;
      padding-bottom: 56px; /* room for the stamp below the terms */
    }
  }

  /* Narrow phones wrap the card text more, so the fan needs a little more height. */
  @media (max-width: 480px) {
    .docs {
      height: 512px;
    }
  }

  @media (min-width: 901px) {
    .faq {
      padding-top: 115px;
      padding-bottom: 115px;
    }
  }
</style>
