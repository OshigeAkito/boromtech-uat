---
import codeIcon from '../../icons/audit/icon-code.svg?raw'
import dataIcon from '../../icons/audit/icon-data.svg?raw'
import infrastructureIcon from '../../icons/audit/icon-infrastructure.svg?raw'
import interfaceIcon from '../../icons/audit/icon-interface.svg?raw'
import knowledgeIcon from '../../icons/audit/icon-knowledge.svg?raw'
import securityIcon from '../../icons/audit/icon-security.svg?raw'
import { useLocale } from '../../i18n'

const { t } = useLocale(Astro.currentLocale)
const [title1, title2] = t.audit.title
const layerKeys = ['interface', 'code', 'data', 'infrastructure', 'security', 'knowledge']
// One icon per layer, drawn in currentColor so it takes each row's text colour.
const icons: Record<string, string> = {
  interface: interfaceIcon,
  code: codeIcon,
  data: dataIcon,
  infrastructure: infrastructureIcon,
  security: securityIcon,
  knowledge: knowledgeIcon,
}
---

<section class="chapter audit-scope" id="audit" aria-labelledby="audit-scope-title">
  <header class="audit-scope-heading">
    <h2 id="audit-scope-title" class="reveal"><span>{title1}</span><wbr /><span>{title2}</span></h2>
    <p>{t.audit.intro}</p>
  </header>

  <dl class="audit-layers">
    {
      t.audit.layers.map(({ layer, check }, i) => (
        <div class={`audit-layer layer-${layerKeys[i]}`}>
          <dt>
            <span class="layer-icon" aria-hidden="true" set:html={icons[layerKeys[i]]} />
            <span class="layer-name">{layer}</span>
          </dt>
          <dd>{check}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .chapter.audit-scope {
    padding: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--f-text);
    font-size: var(--t-body);
    line-height: 1.7;
    border-radius: 0;
  }

  .audit-scope-heading,
  .audit-layer {
    padding-inline-start: max(var(--m), env(safe-area-inset-left));
    padding-inline-end: max(var(--m), env(safe-area-inset-right));
  }

  /* The title, with its intro right under it. */
  .audit-scope-heading {
    display: grid;
    gap: 20px;
    padding-block: clamp(48px, 5vw, 80px) 56px;
  }

  h2 {
    margin: 0;
    font-family: var(--f-display);
    font-size: var(--t-l);
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: -0.025em;
  }

  h2 span {
    white-space: nowrap;
  }

  .audit-scope-heading p {
    max-width: 30em;
    color: var(--muted);
  }

  .audit-layers,
  .audit-layer dd,
  p {
    margin: 0;
  }

  .audit-layers {
    padding: 0;
  }

  .audit-layer {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: var(--gap);
    align-items: center;
    padding-block: 28px;
    border-radius: 0;
  }

  .audit-layer dt {
    min-width: 0;
    font-family: var(--f-display);
    font-size: var(--t-m);
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: -0.01em;
  }

  .audit-layer dt {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .layer-icon {
    flex: none;
    width: 48px;
    height: 48px;
    color: inherit;
  }

  .layer-icon :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .audit-layer dd {
    min-width: 0;
    max-width: 30em;
    font-size: var(--t-body);
    line-height: 1.7;
  }

  .layer-interface {
    min-height: 112px;
    background: var(--night);
    color: var(--on-dark);
  }

  .layer-code {
    min-height: 152px;
    background: var(--soft);
    color: var(--ink);
  }

  .layer-data {
    min-height: 128px;
    background: var(--paper);
    color: var(--ink);
  }

  .layer-infrastructure {
    min-height: 184px;
    background: var(--sunken);
    color: var(--ink);
  }

  .layer-security {
    min-height: 144px;
    background: var(--orange);
    color: var(--ink);
  }

  .layer-knowledge {
    min-height: 168px;
    background: var(--ink);
    color: var(--on-dark);
  }

  @media (max-width: 900px) {
    .audit-scope-heading {
      padding-block: 48px;
    }
  }

  @media (max-width: 639px) {
    .audit-layer {
      grid-template-columns: minmax(0, 1fr);
      align-content: center;
      row-gap: 10px;
      padding-block: 28px;
    }
  }

  @media (min-width: 901px) {
    .audit-scope-heading {
      padding-top: 115px;
    }
  }
</style>
