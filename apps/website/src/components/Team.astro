---
import { Picture } from 'astro:assets'
import borom from '../assets/photos/borom-road.jpg'
import { useLocale } from '../i18n'

const { t } = useLocale(Astro.currentLocale)
const [line1, line2] = t.team.title
---

<section class="chapter team" id="team" aria-labelledby="team-title">
  <div class="panel">
    <div class="panel-left">
      <h2 id="team-title" class="l reveal">{line1}<br />{line2}</h2>
      <p class="place reveal">{t.team.photoCaption}</p>
      <figure class="portrait">
        <Picture
          src={borom}
          formats={['avif', 'webp']}
          widths={[480, 800, 1200, 1600]}
          sizes="(max-width: 900px) 86vw, 38vw"
          alt={t.team.photoAlt}
          loading="lazy"
        />
      </figure>
    </div>
    <div class="panel-right">
      {
        t.team.points.map(({ heading, body }) => (
          <div class="reveal">
            <h3>{heading}</h3>
            <p>{body}</p>
          </div>
        ))
      }
      <a class="button reveal" href="#contact">{t.team.cta}</a>
    </div>
  </div>
</section>
