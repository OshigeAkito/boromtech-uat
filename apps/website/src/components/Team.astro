---
import { Picture } from 'astro:assets'
import borom from '../assets/photos/borom-road.jpg'
---

<section class="chapter team" id="team" aria-labelledby="team-title">
  <div class="panel">
    <div class="panel-left">
      <h2 id="team-title" class="l reveal">ทีมจาก Consulting<br />ระดับโลก</h2>
      <p class="place reveal">ภาพ: ถนนบรมราชชนนี กรุงเทพฯ</p>
      <figure class="portrait">
        <Picture
          src={borom}
          formats={['avif', 'webp']}
          widths={[480, 800, 1200, 1600]}
          sizes="(max-width: 900px) 86vw, 38vw"
          alt="ถนนบรมราชชนนี กรุงเทพฯ ทางยกระดับเหนือถนนที่มีรถสัญจรหนาแน่น"
          loading="lazy"
        />
      </figure>
    </div>
    <div class="panel-right">
      <div class="reveal">
        <h3>มาตรฐานโปรเจกต์ใหญ่ สำหรับงานทุกขนาด</h3>
        <p>ในวันที่ใครก็สร้างโค้ดด้วย AI ได้ สิ่งที่แยกโปรเจกต์ที่รอดออกจากโปรเจกต์ที่พังคือคนดูแล ทีมของเรามาจากบริษัท Consulting ระดับโลก นำวิธีคิดการออดิต การวางระบบ และการส่งมอบมาตรฐานสูง มาใช้แก้ปัญหาและดูแลระบบให้คุณ ทั้งงานขนาดเล็กและระดับองค์กร</p>
      </div>
      <div class="reveal">
        <h3>กู้คืนโปรเจกต์แพงๆ โดยไม่มีบิลบานปลาย</h3>
        <p>เราเข้าใจความเจ็บปวดของการจ่ายเงินก้อนโตแล้วได้ระบบที่ใช้ไม่ได้ เราจึงไม่คิดค่าใช้จ่ายรายชั่วโมงแบบไม่รู้จบ ทุกทาสก์ตกลงราคาฟิกซ์ไพรซ์ก่อนเริ่ม และแจกแจงทุกบรรทัดในใบเสนอราคาชัดเจน</p>
      </div>
      <a class="button reveal" href="#contact">คุยกับทีม</a>
    </div>
  </div>
</section>
