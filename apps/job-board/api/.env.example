# crew-api configuration. Production values come from Cloud Run env vars and Secret Manager.
# Local dev: Vite proxies /api to http://localhost:8080, so PUBLIC_ORIGIN is the Vite origin and EDGE_KEY may
# be empty (allowed only for http://localhost).

PORT=8080
PUBLIC_ORIGIN=http://localhost:5173
# Shared with the edge Worker, sent as X-BT-Edge. Required unless PUBLIC_ORIGIN is http://localhost.
EDGE_KEY=

# bt_gateway on Neon's pooled host (PgBouncer, transaction mode). Locally: docker Postgres after migrate.sh.
DATABASE_URL=postgres://bt_gateway:test@localhost:55432/bt_go
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# R2 (S3 API). Endpoint defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com; R2_ENDPOINT overrides
# it for a local S3-compatible store, which usually wants its own region (us-east-1).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bt-crew-files
# R2_ENDPOINT=http://localhost:59000
# R2_REGION=us-east-1

# `crew-api sweep` only (nightly, GitHub Actions): bt_sweeper, which can execute gate.sweep and nothing else.
# SWEEPER_DATABASE_URL=postgres://bt_sweeper:test@localhost:55432/bt_go
